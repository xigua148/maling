# ============================================================================
# 码铃（MaLing）仓库忽略规则
# 基线：GitHub 官方 Python 模板 + 本项目实况补充
# ⚠️ 注意：version.json 必须纳入版本控制（它是客户端更新指针），切勿忽略。
# ============================================================================

# ---- 密钥与本地配置（最高优先级）----
# 防止真实 API key 被上传：config.yaml 内含个人密钥配置，仓库只应保留代码内置的默认模板
config.yaml

# 通用环境变量文件，常被用于本地存放密钥 / token，不应进入版本库
.env

# ---- Python 字节码与虚拟环境 ----
# Python 字节码缓存目录，随解释器版本变化，与源码无关且污染仓库
__pycache__/
# 编译出的字节码文件，同上，由 .py 源码生成，不纳入版本控制
*.pyc
*.pyo
*.pyd

# 虚拟环境：本地依赖安装目录，体积大且可由依赖清单重建
.venv/
venv/
env/

# 打包输出
*.egg-info/
.eggs/
dist/
build/

# ---- 本项目：PyInstaller 构建产物 ----
# 版本化构建产物目录（命名格式: build_v*/dist_v*），单目录可达 200–700MB
build_v*/
dist_v*/

# 打包态验收用的独立产物目录（dist_st_acc 等）：含内置 ST 与 Pi 运行时，
# 单次约 1.2GB / 2.3 万文件，属本轮构建产物而非源码。
# 注意：该目录**不含** pi_runtime，须按发版清单第 4b 步补跑
# `python copy_pi_runtime.py --dist dist_st_acc/maling` 才是可用包（发版走 dist/ 同名流程）。
dist_st_acc/
dist_acc*/

# sidecar（自动更新器）的独立构建产物，由 updater.spec 生成
dist_updater/
build_updater/

# 构建脚本产生的版本化发布目录（命名格式: release_v*）
release_v*/

# 当前活动发布目录（build_release.py 默认 --out release，含完整制品 ~515MB；历史版本见 release_v*/）
release/

# PyInstaller spec 的备份文件，属本地编辑残留，开源包无需携带
*.spec.bak

# 发布包
*.zip

# ---- 本项目：Pi 编程引擎运行时（体积最大项）----
# _internal/ 存放「打包后复制」的 Pi 运行时（node.exe + node_modules，约 226MB / 1.3 万文件）
# 与其派生的 pi_gateway 副本。属构建输入而非源码，且为第三方二进制，不宜纳入公开仓库。
# 需构建发布包时，先在本机运行：python copy_pi_runtime.py
_internal/

# ---- 本项目：内置 SillyTavern（第三方 Node 服务，AGPL-3.0）----
# vendor/sillytavern/ 为官方 SillyTavern 源码（release 分支，约 59MB / 1000 文件）。
# 其依赖树由 `npm install --omit=dev` 生成（约 280MB / 2 万文件），属构建输入，不入库。
# 注意：LICENSE 类文件必须随包分发（AGPL §4 "keep intact all notices"），故不得按 *.md 通配排除。
vendor/sillytavern/node_modules/

# ---- 测试与静态检查缓存 ----
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# ---- 排查用日志与临时调试目录（历史遗留）----
*.log
.tmp_dbg/
_scratch_*/

# ---- 测试沙箱与构建副产物（根目录下划线前缀，整类忽略）----
# 根目录下所有以 `_` 开头的条目一律不入库：各轮测试的隔离沙箱（_pytest_tmp / _v18_trash /
# _v18_b4_tmp）、构建中间产物（_build173）、UI 截图（_ui_shots*）、以及排查遗留的
# _v2017_* / _v219_* / _smoke_* 等。本项目源码不使用下划线前缀，故整类忽略安全。
# 前导 `/` 锚定到仓库根，避免误伤子目录内的合法文件名。
/_*/
/_*

# 测试沙箱的点号前缀变体（.bt / .bt_test_* 等），同样是各轮测试的隔离目录
.bt*/
/_*

# ---- 工具私有元数据（不属项目代码，且可能含会话/记忆内容）----
# 注意：该目录是工具运行所需，勿删除；仅不纳入版本控制
.workbuddy/

# ---- 编辑备份与临时打包产物（v2.1 补）----
# `*.bak_*`：历史编辑备份（如 main_window.py.bak_transition / version.json.bak_210）
*.bak
*.bak_*
# `wN_onedir` / `wN_onefile`：某轮 ad-hoc 打包产物目录（单个 30–200MB）
w[0-9]*_onedir/
w[0-9]*_onefile/
