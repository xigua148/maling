    {
      "cast_id": "cast_guest_rain",
      "role": "雨夜来客",
      "card_id": "",
      "card_snapshot": {
        "name": "沈默",
        "description": "雨里走进来，肩上全是水。话不多，坐下先看那盏灯笼，像在等一个很久以前的人。"
      }
    },
    {
      "cast_id": "cast_regular",
      "role": "老常客",
      "card_id": "",
      "card_snapshot": {
        "name": "老周",
        "description": "总坐窗边那张桌子，酒要温的。走时会把椅子轻轻推回去，从不多留一盏灯的工夫。"
      }
    }
  ]
