    {"action": "pick_followup", "args": {"min_hours": 1, "max_hours": 72}, "expect": {"out_is_null": true}},
    {"action": "mute_topic", "args": {"subject": "换工作的事", "days": -15}},
    {"action": "pick_followup", "args": {"min_hours": 1, "max_hours": 72}, "expect": {"out_not_null": true}}
  ],
